{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & run current file",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": ["${file}"],
            "options": { "shell": { "executable": "cmd.exe", "args": ["/c"] } },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build & run metro station",
            "type": "shell",
            "command": "${workspaceFolder}/build_metro.bat",
            "options": { "shell": { "executable": "cmd.exe", "args": ["/c"] } },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
